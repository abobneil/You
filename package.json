{
  "name": "you",
  "private": true,
  "version": "0.1.0",
  "description": "A place to keep everything about yourself. Your data stays on your devices.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "audible": "node --disable-warning=ExperimentalWarning server/audible/cli.ts",
    "check:dist": "node scripts/check-dist.mjs",
    "build:helper": "node scripts/build-helper.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@xmldom/xmldom": "^0.9.12",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "zxing-wasm": "^3.1.6"
  },
  "engines": {
    "node": ">=22.18"
  }
}
